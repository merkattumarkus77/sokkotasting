# Kopioi tämä tiedosto nimelle .env.local ja täytä arvot Firebase-konsolista
# (Project settings -> General -> Your apps -> Web app -> SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" ohjaa selaimen Firestore-SDK:n paikalliseen emulaattoriin
# (firebase emulators:start --only firestore) tuotanto-Firestoren sijaan.
# Käytä tätä aina paikallisessa kehityksessä ja testauksessa.
NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=false
