# Kopioi tämä tiedosto nimelle .env.local ja täytä arvot Firebase-konsolista
# (Project settings -> General -> Your apps -> Web app -> SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" ohjaa selaimen Firestore-SDK:n paikalliseen emulaattoriin
# (firebase emulators:start --only firestore) tuotanto-Firestoren sijaan.
# Käytä tätä aina paikallisessa kehityksessä ja testauksessa.
NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=false

# Istuntoevästeen (jose/JWT) allekirjoitusavain, palvelinpuolen salaisuus.
# Pitkä satunnainen merkkijono, esim: openssl rand -base64 32
# Ei NEXT_PUBLIC_-etuliitettä — ei saa koskaan päätyä selainbundleen.
SESSION_SECRET=

# firebase-admin: palvelutilin avain. Paikallisessa kehityksessä TARPEETON —
# lib/firebaseAdmin.ts lukee oletuksena serviceAccountKey.json-tiedoston
# projektin juuresta (gitignoressa). Tämä muuttuja on vain Verceliä varten,
# jossa ei ole pysyvää tiedostojärjestelmää: serviceAccountKey.json:n koko
# sisältö base64-koodattuna yhdelle riville, esim:
#   openssl base64 -A -in serviceAccountKey.json
# Aseta vain Vercelin Project Settings -> Environment Variables -osiossa,
# ei koskaan tänne .env.localiin.
FIREBASE_SERVICE_ACCOUNT_JSON=
